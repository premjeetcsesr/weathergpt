# ==========================================
# WeatherGPT Backend Configuration Template
# ==========================================

# Application Settings
PROJECT_NAME="WeatherGPT API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"

# Weather Provider Configuration (OpenWeatherMap)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
GEOCODING_API_BASE_URL=https://api.openweathermap.org/geo/1.0

# Step 7 Official IMD Provider & Multi-Provider Configuration
IMD_API_BASE_URL=
IMD_API_KEY=
DEFAULT_WEATHER_PROVIDER=openweather
ENABLE_IMD_PROVIDER=true
ENABLE_NWP_PROVIDER=false
ENABLE_RADAR_PROVIDER=false
ENABLE_SATELLITE_PROVIDER=false

# Doppler Weather Radar Provider (IMD / Authorized Feed)
IMD_RADAR_ENABLED=false
IMD_RADAR_BASE_URL=
IMD_RADAR_API_KEY=

# Meteorological Satellite Provider (INSAT-3D / 3DR / 3DS)
IMD_SATELLITE_ENABLED=false
IMD_SATELLITE_BASE_URL=
IMD_SATELLITE_API_KEY=

# Database Configuration (MongoDB)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=weathergpt
MONGODB_DATABASE=weathergpt

# Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting (Step 8)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_WEATHER_PER_MINUTE=60

# LLM Configuration (OpenAI-compatible) - Optional, grounded fallback used if empty
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Security & CORS (Production: specify exact domains without wildcard)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Real-Time Alerts & WebSocket
ALERT_CHECK_INTERVAL_SECONDS=300
WEBSOCKET_ENABLED=true
MAX_WS_CONNECTIONS=100
CACHE_TTL_SECONDS=300
WEATHER_CACHE_TTL=300
