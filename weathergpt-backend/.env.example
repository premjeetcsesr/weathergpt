# ==========================================
# WeatherGPT Backend Configuration
# ==========================================

# Application Settings
PROJECT_NAME="WeatherGPT API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Weather Provider Configuration (OpenWeatherMap)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
GEOCODING_API_BASE_URL=https://api.openweathermap.org/geo/1.0

# Database Configuration (PostgreSQL with asyncpg) - Optional in development
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/weathergpt

# LLM Configuration (OpenAI-compatible) - Optional, safe fallback used if empty
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Caching
CACHE_TTL_SECONDS=300
